# Copie para .env.local (ignorado pelo git) e preencha.
# Supabase > Project Settings > API. Use SOMENTE a chave "anon"/publishable aqui:
# nunca coloque a service_role em variáveis VITE_* (vão para o navegador).
# Sem estas variáveis o site roda em modo demonstração, com dados fictícios.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
